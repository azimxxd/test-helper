# --- какой провайдер использовать ---
# anthropic  — платный, самый точный, понимает скриншоты
# gemini     — бесплатный, понимает скриншоты, ключ на aistudio.google.com
# groq       — бесплатный, очень быстрый, сильная математика, без скриншотов
# cerebras   — бесплатный, крупная модель, без скриншотов
# openrouter — бесплатный, сильные рассуждения, небольшой суточный лимит
THELPER_PROVIDER=gemini

# Запасной провайдер: включается, если у основного кончился лимит или он упал.
# Картинки ему не отправляются, если он их не понимает.
THELPER_FALLBACK=groq

# --- ключи: нужен только тот, что у выбранного провайдера ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=

# Необязательно: общий секрет между сервером и расширением.
# Если задан — впиши это же значение в настройках расширения.
THELPER_TOKEN=

# Необязательно
PORT=8787
HOST=127.0.0.1

# Модель. Пусто — берётся та, что стоит у провайдера по умолчанию.
THELPER_MODEL=

# Свой адрес API: для прокси и зеркал
THELPER_BASE_URL=
THELPER_FALLBACK_BASE_URL=
